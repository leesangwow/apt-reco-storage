# 공개 값 (브라우저로 전달됨)
NEXT_PUBLIC_SUPABASE_URL=https://[project-ref].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 서버 전용 — 절대 NEXT_PUBLIC_ 접두사를 붙이지 말 것
# ingestion_runs는 RLS로 anon 접근이 막혀 있어 관리자 페이지 조회에만 사용한다
SUPABASE_SERVICE_ROLE_KEY=

# /admin 로그인 비밀번호. 세션 쿠키 서명 키로도 쓰이므로
# 값을 바꾸면 기존 로그인 세션이 모두 무효화된다
ADMIN_PASSWORD=
