# 공개 값 (브라우저로 전달됨)
NEXT_PUBLIC_SUPABASE_URL=https://[project-ref].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 서버 전용 — 절대 NEXT_PUBLIC_ 접두사를 붙이지 말 것
# ingestion_runs는 RLS로 anon 접근이 막혀 있어 관리자 페이지 조회에만 사용한다
SUPABASE_SERVICE_ROLE_KEY=

# /admin 로그인 비밀번호. 세션 쿠키 서명 키로도 쓰이므로
# 값을 바꾸면 기존 로그인 세션이 모두 무효화된다
ADMIN_PASSWORD=

# /admin에서 수집 워크플로를 직접 실행하기 위한 GitHub 토큰.
# fine-grained PAT · 이 저장소만 · 권한은 Actions(Read and write) 하나면 된다.
# 없으면 현황 조회는 그대로 되고 수집 시작 버튼만 잠긴다.
# 같은 값을 저장소 Actions 시크릿에도 넣어야 자동 재시도(retry-collect.yml)가 돈다.
COLLECT_DISPATCH_TOKEN=

# 기본값 leesangwow/apt-reco-storage · main. 저장소를 옮길 때만 건드린다
# COLLECT_REPO=
# COLLECT_REF=
